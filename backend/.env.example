# Server Port
PORT=4000

# MongoDB Connection String (Atlas URI or leave blank to use the built-in local JSON storage engine)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pizza-dev

# JWT Secret for User Authentication
JWT_SECRET="your_jwt_secret_key_here"

# Stripe Secret Key (for online payments)
STRIPE_SECRET_KEY="sk_test_..."

# Frontend URL (optional, automatically auto-detected if left empty)
FRONTEND_URL="https://your-frontend-domain.vercel.app"

# Email Notifications (optional)
ALERT_EMAIL="your-email@gmail.com"
ALERT_EMAIL_PASS="your-email-app-password"
ALERT_RECIPIENT="your-email@gmail.com"
